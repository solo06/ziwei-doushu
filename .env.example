# 复制为 .env.local 后填入实际值

# ─── AI 解读（OpenAI 兼容协议，任意厂商）───
# 本仓库已实现 /api/interpret 与 /api/heming，填下面三项即可启用 AI 解读。
# 不填也能正常排盘、看古籍，只是点「AI 解读」会提示未配置。
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=your-api-key
AI_MODEL=deepseek-chat

# 可选：生成参数与限流
# AI_MAX_TOKENS=1600
# AI_TEMPERATURE=0.7
# AI_TIMEOUT_MS=90000
# AI_RATE_LIMIT_PER_MIN=6
# AI_DAILY_LIMIT=200

# ─── 站点 ───
# 公开镜像请保持默认值，避免 canonical / sitemap 指向别人的域名
NEXT_PUBLIC_SITE_URL=http://localhost:3000
